# Copy to .env for local development (never commit .env)

# Listen address (not secret).
# MotK / psxrecomp clients default to ws://127.0.0.1:8765 — use that port for them.
# HTTP /v1 API can share the same listener.
BIND_ADDR=0.0.0.0:8765

# If true, JWT_SECRET_CURRENT must be set or the server will not start
REQUIRE_AUTH=false

# HMAC signing secrets for short-lived JWTs — set in production via secrets manager
# JWT_SECRET_CURRENT=
# JWT_SECRET_PREVIOUS=

# Optional database (defaults to sqlite:recomp-net-server.db?mode=rwc if unset)
# DATABASE_URL=sqlite:recomp-net-server.db?mode=rwc

# Lobby defaults
# LOBBY_DEFAULT_INPUT_DELAY=2
# LOBBY_DEFAULT_SLOT_COUNT=2
# LOBBY_ROOM_IDLE_SECS=600
# LOBBY_HEARTBEAT_TIMEOUT_SECS=30
# LOBBY_PROTOCOL_MAGIC=0x524E4554

# Comma-separated allowlist of game_id prefixes (empty = allow any non-empty game_id in dev)
# Example SNES: snes:sha256:<hex>,snes:crc32:<hex>
# LOBBY_GAME_ALLOWLIST=

# Ceiling on distinct `game` label values in Prometheus match-start series when
# no allowlist is set. Games past the cap fold into `other` (default 64). With
# LOBBY_GAME_ALLOWLIST set, only allowlisted games get their own label.
# METRICS_GAME_LABEL_LIMIT=64

# Public hostname clients use for this server (lobby WS URL host). Also used as
# the UDP input-relay advertise host when INPUT_RELAY_ADVERTISE_HOST is unset.
# If both are unset, startup STUN-discovers this machine's public IPv4 (never
# advertises 127.0.0.1 unless INPUT_RELAY_ALLOW_LOOPBACK=1).
# PUBLIC_HOST=netplay.example.com
# LOBBY_PUBLIC_HOST=   # alias of PUBLIC_HOST

# UDP delay-sync input relay (star topology). Online start always opens the SFU.
# Clients dial ADVERTISE_HOST:PORT (MotK may rewrite host to the lobby WS host).
# INPUT_RELAY_ENABLED=1
# INPUT_RELAY_BIND=0.0.0.0:8777
# INPUT_RELAY_ADVERTISE_HOST=   # default: PUBLIC_HOST / LOBBY_PUBLIC_HOST / STUN public IPv4
# INPUT_RELAY_ADVERTISE_PORT=8777
# INPUT_RELAY_LAN_HOST=192.168.1.10  # used when every seated WS peer is direct LAN
# INPUT_RELAY_LAN_GATEWAY=192.168.1.1  # hairpin source; default guess = LAN_HOST → .1
# (Linux) SFU pins UDP source via IP_PKTINFO to the address each peer dialed —
# needed when the host has eth+wlan on the same subnet.
# INPUT_RELAY_ALLOW_LOOPBACK=0  # set 1 only for same-machine-only testing
# INPUT_RELAY_STUN=stun.l.google.com:19302  # optional STUN for public-IP discovery

# Coturn (time-limited TURN credentials for GET /v1/turn-credentials)
# COTURN_STATIC_AUTH_SECRET must match turnserver.conf static-auth-secret.
# Full guide: docs/COTURN.md
# required for turn-credentials endpoint
# COTURN_STATIC_AUTH_SECRET=
# COTURN_REALM=recomp-net
# public DNS name clients use (cert SAN)
# COTURN_HOST=
# COTURN_STUN_HOST=
# COTURN_TURN_HOST=
# COTURN_STUN_PORT=3478
# COTURN_TURN_PORT=3478
# COTURN_TURNS_PORT=5349
# COTURN_CREDENTIAL_TTL_SECS=86400
